            "x-ves-example": "CE-Mumbai"
          },
          "virtual_server": {
            "type": "string",
            "description": " Name of the Virtual Server front-ending the Application\n\nExample: ` \"App Portal\"`",
            "title": "virtual_server",
            "x-displayname": "Virtual Server",
            "x-ves-example": "App Portal"
          }
        }
