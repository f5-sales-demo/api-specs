            "title": "connected",
            "x-displayname": "Connected",
            "x-ves-example": "true"
          },
          "operator": {
            "type": "string",
            "description": " Network Operator to which is device connected\n\nExample: ` \"T-Mobile\"`",
            "title": "Operator",
            "x-displayname": "Network Operator",
            "x-ves-example": "T-Mobile"
          },
          "service_type": {
            "type": "string",
            "description": " Type of Service that is device using\n\nExample: ` \"4G\"`",
            "title": "ServiceType",
            "x-displayname": "Type of Service",
            "x-ves-example": "4G"
